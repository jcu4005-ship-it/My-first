# ─────────────────────────────────────────────────────────────
# 환경변수 예시 — 이 파일에는 "이름"만 적고 실제 값은 넣지 않습니다.
# 로컬 개발: 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 Git에 올라가지 않음)
# 스테이징/운영: Vercel 프로젝트 설정 > Environment Variables 에 입력합니다.
# NEXT_PUBLIC_ 으로 시작하는 값은 브라우저에 노출됩니다. 비밀키에는 절대 붙이지 마세요.
# ─────────────────────────────────────────────────────────────

# 실행 환경: local | staging | production
NEXT_PUBLIC_APP_ENV=local
# 서비스 주소 (운영 환경 필수) 예: https://example.com
NEXT_PUBLIC_SITE_URL=

# Supabase — 프로젝트 설정 > API 에서 확인 (환경마다 다른 프로젝트 사용)
NEXT_PUBLIC_SUPABASE_URL=
# 공개용 키 (publishable 또는 legacy anon). 브라우저에 노출되어도 되는 키
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ⚠ 비밀키 (secret 또는 legacy service_role). 서버 전용. 0단계에서는 사용하지 않음
SUPABASE_SECRET_KEY=

# 결제 모드: 현재 test 만 허용 (live 는 PG 계약·정산구조 확인 + 승인 후 활성화)
NEXT_PUBLIC_PAYMENT_MODE=test
# 토스페이먼츠 테스트 키 (test_ 로 시작). 4단계(결제)에서 사용
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
